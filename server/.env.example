# Absolute path to the z88dk installation root (folder containing bin/, lib/).
Z88DK_HOME=C:\z88dk

# Absolute path to the cc65 installation root (folder containing bin/).
CC65_HOME=C:\cc65

# Port for the compile API server.
PORT=4000

# Max concurrent compile jobs (protects the host from resource exhaustion).
MAX_CONCURRENT_COMPILES=2

# Per-compile timeout in milliseconds.
COMPILE_TIMEOUT_MS=10000

# Max C source size accepted, in bytes.
MAX_SOURCE_BYTES=65536
